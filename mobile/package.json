{
  "name": "surge-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor wrapper for the surge read-only PWA (iOS / Android).",
  "scripts": {
    "build:web": "python -m surge pages-export --out mobile/www",
    "add:ios": "cap add ios",
    "add:android": "cap add android",
    "sync": "cap sync",
    "copy": "cap copy",
    "open:ios": "cap open ios",
    "open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/ios": "^6.0.0"
  }
}
